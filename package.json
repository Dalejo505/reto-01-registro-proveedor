{
  "name": "agente-registro-proveedor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["web"],
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server.ts\" \"npm run dev --workspace reto-01-web\"",
    "demo": "tsx demo.ts",
    "test": "tsx --test src/tools/proveedor.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace reto-01-web",
    "lint": "eslint src demo.ts && npm run typecheck --workspace reto-01-web",
    "build": "npm run typecheck && npm run build --workspace reto-01-web",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@hono/node-server": "^1.19.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "hono": "^4.10.4",
    "pdf-lib": "^1.17.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=20"
  }
}
